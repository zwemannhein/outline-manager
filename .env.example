# Admin Credentials (REQUIRED)
# WARNING: Change these defaults in production!
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_password_min_8_chars

# JWT Secret (REQUIRED)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# Redis/KV Configuration (REQUIRED)
# Use either Upstash Redis or Vercel KV
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# OR use Vercel KV
# KV_REST_API_URL=https://your-kv-instance.vercel.com
# KV_REST_API_TOKEN=your_kv_token

# Optional: Logging
LOG_LEVEL=info

# Environment
NODE_ENV=production

# Telegram Bot Integration (OPTIONAL)
# Get bot token from @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Get your chat ID from @userinfobot on Telegram: https://t.me/userinfobot
# Comma-separated for multiple admins.
TELEGRAM_CHAT_ID=123456789

# Webhook authenticity secret (STRONGLY RECOMMENDED when Telegram is enabled).
# Without it, the webhook cannot verify that a delivery genuinely came from
# Telegram and must rely on the payload's chat_id, which is attacker-controlled.
#
# Generate:  openssl rand -hex 32
# Register:  curl -X POST "https://api.telegram.org/bot<BOT_TOKEN>/setWebhook" \
#              -d "url=https://<your-domain>/api/v1/telegram/webhook" \
#              -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_min_16_chars
