# Admin Credentials (REQUIRED)
# Populate these only in the deployment environment; never commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# JWT Secret (REQUIRED)
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Redis/KV Configuration (REQUIRED)
# Use either Upstash Redis or Vercel KV
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OR use Vercel KV
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: Logging
LOG_LEVEL=info

# Environment
NODE_ENV=production

# Telegram Bot Integration (OPTIONAL)
# Get bot token from @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Bot username (without @) — required for the Telegram Approver deep-link feature.
# Find it in @BotFather: /mybots → your bot → Edit Bot → Edit Username
TELEGRAM_BOT_USERNAME=

# Optional when at least one linked approver exists, but strongly recommended as
# the legacy/private fallback recipient. Password reset and order notifications
# currently use this static recipient list directly.
# IMPORTANT: This is ALWAYS included as a login approval target, even when dynamic
# approvers are configured in Settings → Telegram Approvers. It acts as a reliable
# fallback channel. Dynamic approvers are merged alongside it (not instead of it).
# Comma-separated for multiple static targets.
TELEGRAM_CHAT_ID=

# ─── Permanent dynamic access keys (VPN core) ─────────────────────────────────

# Canonical Vercel resolver. Customers receive:
#   ssconf://outline-manager.vercel.app/k/<TOKEN>#<URL-ENCODED-NAME>
# Cloudflare Worker/KV remains a non-canonical projection/cache layer.
# Not a secret (it appears in every customer key). The NEXT_PUBLIC_ copy lets the
# admin dashboard render a customer's key without a server round trip.
DYNAMIC_KEY_BASE_URL=https://outline-manager.vercel.app
NEXT_PUBLIC_DYNAMIC_KEY_BASE_URL=https://outline-manager.vercel.app

# Cloudflare KV, used ONLY as a public projection of the dynamic key mapping.
# NOTE: KV_REST_API_* above refers to UPSTASH. These CF_* variables are the
# Cloudflare ones — do not mix them up.
#
# CF_KV_API_TOKEN must be a custom token scoped to:
#   Account > Workers KV Storage > Edit   (restricted to the one namespace)
# Never a Global API Key. Server-side only; never exposed to the browser.
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_KV_API_TOKEN=

# Shared secret for the hourly maintenance job. The Cloudflare scheduled Worker
# sends this as a bearer token to POST /api/v1/cron/tick.
# Generate: openssl rand -hex 32
CRON_SECRET=

# How "Disable customer" blocks traffic on the Outline server.
#   limit  (default) set the key's data limit to DISABLE_BLOCK_BYTES
#   remove           delete the key; reactivation recreates it behind the SAME
#                    permanent token, so the customer's URL never changes
DISABLE_STRATEGY=limit

# Block limit under the "limit" strategy. MUST be 0: `usage >= 0` is true even
# for a key with no traffic yet, whereas 1 would fail to block a brand-new key.
DISABLE_BLOCK_BYTES=0

# Webhook authenticity secret (STRONGLY RECOMMENDED when Telegram is enabled).
# Without it, the webhook cannot verify that a delivery genuinely came from
# Telegram and must rely on the payload's chat_id, which is attacker-controlled.
#
# Generate:  openssl rand -hex 32
# Register:  curl -X POST "https://api.telegram.org/bot<BOT_TOKEN>/setWebhook" \
#              -d "url=https://<your-domain>/api/v1/telegram/webhook" \
#              -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_WEBHOOK_SECRET=

# ─── Optional: Server resource metrics (AWS / Lightsail) ─────────────────────
#
# CPU / RAM / Disk / Network collection is not implemented. The monitoring page
# always displays "Not configured"; adding credentials alone will not enable it.
#
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
