{
  "name": "outline-config-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers for Outline dynamic access keys: public config resolver + hourly cron trigger",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:cron": "wrangler deploy --config wrangler.cron.toml",
    "tail": "wrangler tail",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.9.3",
    "wrangler": "^3.99.0"
  }
}
